{
  "name": "axs-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=10"
  },
  "scripts": {
    "sabrina:dev": "pnpm --filter @axs/sabrina dev",
    "sabrina:build": "pnpm --filter @axs/sabrina build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "audit": "pnpm audit"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": "8.5.15",
      "undici@>=7.0.0 <7.28.0": "7.28.0"
    }
  }
}
