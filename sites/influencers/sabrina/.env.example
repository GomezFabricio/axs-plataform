# ─── CMS ─────────────────────────────────────────────────────────────────────
# URL base del CMS (apps/cms). El fetch de obtenerSitioSabrina() la lee de aquí.
# CMS_URL se usa en Server Components (server-side only, no se expone al browser).
# NEXT_PUBLIC_CMS_URL es el fallback para uso client-side si algún día se necesita.
#
# Para desarrollo local (CMS corriendo en docker compose + next dev --port 3001):
CMS_URL=http://localhost:3001

# Para producción, apuntar al dominio real del CMS:
# CMS_URL=https://cms.axs-platform.com
