# ─── Base de datos ───────────────────────────────────────────────────────────
# URI de conexión a PostgreSQL.
# Para desarrollo local con Docker (ver docker-compose.yml):
DATABASE_URI=postgresql://axs:axsdev@localhost:5432/axs_cms

# ─── Payload ─────────────────────────────────────────────────────────────────
# Clave secreta de Payload (admin sessions, tokens). Mínimo 32 caracteres.
PAYLOAD_SECRET=cambia-esta-clave-secreta-por-una-aleatoria-larga

# ─── Puerto del CMS ──────────────────────────────────────────────────────────
# El CMS corre en el puerto 3001 por defecto (ver package.json scripts).
# Los sitios lo consumen mediante CMS_URL (ver sites/influencers/sabrina/.env.example).
